{
  "ConnectionStrings": {
    "DefaultConnection": "Host=spsql.home.arpa;Port=5432;Database=demo-gateway;Username=app;Password=Admin@123",
    "MongoDb": "mongodb://admin:Admin%40123@mongodb.home.arpa:27017/?authSource=admin",
    "Redis": "redis.home.arpa:6379,password=Admin@123"
  },
  "Redis": {
    "ConnectionString": "redis.home.arpa:6379,password=Admin@123",
    "InstanceName": "demo-gateway_",
    "SessionKeyPrefix": "sess:",
    "ConnectionKeyPrefix": "conn:",
    "ParticipantKeyPrefix": "part:",
    "SignalRKeyPrefix": "signalr:"
  },
  "OpenRouter": {
    "ApiKey": "sk-or-v1-f48ab5d617596eca2687 41fe51d1637da3fb12e58e56f67ca3d6953d3ed28184",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "Model": "minimax/minimax-m2.5"
  },
  "Minio": {
    "Endpoint": "minio-s3.home.arpa",
    "AccessKey": "admin",
    "SecretKey": "Admin@123",
    "BucketName": "demo-gateway",
    "UseSsl": true
  },
  "Dds": {
    "UseRealDds": true,
    "NativeLibraryPath": "",
    "TimeoutMs": 5000,
    "EnableGracefulFallback": true
  },
  "Authentik": {
    "Authority": "https://authentik.home.arpa/application/o/payment-gateway/",
    "Audience": "payment-gateway",
    "ValidAudiences": [
      "account"
    ],
    "RequireHttpsMetadata": true,
    "MerchantIdClaim": "merchant_id",
    "RoleClaims": [
      "roles",
      "role",
      "groups"
    ],
    "AdminRoles": [
      "Admin",
      "admin"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Elasticsearch"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "FromExceptionData",
      "WithMachineName",
      "WithEnvironmentUserName",
      "WithThreadId",
      "WithProcessId"
    ],
    "Properties": {
      "Application": "PaymentGateway.Api",
      "Environment": "Production"
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "EnableOtlp": false,
    "OtelEndpoint": "http://localhost:4317",
    "EnableConsoleExporter": false,
    "EnableElasticsearchLogging": false,
    "ElasticsearchUrl": "https://elasticsearch.home.arpa",
    "SkipTlsValidation": false,
    "AllowSelfSignedCertificates": false,
    "ElkKibanaUrl": "https://kibana.home.arpa/",
    "SamplingRate": 0.1,
    "BatchSize": 100,
    "FlushIntervalMs": 5000
  }
}
